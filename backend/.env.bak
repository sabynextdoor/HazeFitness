DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass123
DB_NAME=sarogym
DB_SSL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
PORT=4000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000
ALLOW_PUBLIC_STAFF_SIGNUP=true
# Razorpay — paste real test/live keys from https://dashboard.razorpay.com to go live.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Google OAuth — create an OAuth client at https://console.cloud.google.com/apis/credentials
# Leave blank to hide the "Continue with Google" button on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Clerk — create an app at https://dashboard.clerk.com
# CLERK_SECRET_KEY makes Clerk sign-in / sign-up (incl. "Continue with Google") live.
# CLERK_PUBLISHABLE_KEY is public and mirrored to the frontend build.
# CLERK_DOMAIN is your Clerk app domain URL, e.g. https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_DOMAIN=